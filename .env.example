# Copy to .env and fill in the values. Never commit .env.

# Public site URL, used for metadata, sitemap, robots.txt and llms.txt.
# Falls back to VERCEL_URL (set automatically by Vercel), then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Loops: newsletter and lead-magnet signups (app/api/loops/subscribe).
LOOP_API_KEY=

# Supabase: contact form submissions (app/contact/actions.ts).
# The service role key is server-only; never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to contact_submissions.
SUPABASE_CONTACT_TABLE=

# Digital Leak Audit (app/api/audit). Quiz signups go to Loops with the event
# "digitalLeakAudit", userGroup/source "digital-leak-audit" and the quiz answers
# as event properties. Uses LOOP_API_KEY above.
# Server-only. Link to the audit PDF, returned to the visitor after the quiz.
# Leave empty and the thank-you screen says the PDF will arrive by email.
AUDIT_PDF_URL=
# Server-only. Cal.com booking link. Not rendered anywhere on the site: it lives
# inside the PDF. Kept here so there is one place to change it.
CAL_BOOKING_URL=
